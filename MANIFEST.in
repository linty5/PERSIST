include pyproject.toml README.md LICENSE
include CITATION.cff
include THIRD_PARTY_LICENSES/TransNetV2-LICENSE
recursive-include src/persist_sbd *.py
prune dev
prune tests
prune tools
prune .git
prune .venv
prune build
prune dist
prune release
prune assets
prune docs
exclude INTERNAL_*
